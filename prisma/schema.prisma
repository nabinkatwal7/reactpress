generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  memberships   SiteMember[]
  apiTokens     ApiToken[]
  /// Can manage the whole network (sites, users, network themes/plugins).
  isSuperAdmin  Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  pages         Page[]
  uploads       Media[]
  comments      Comment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id           String           @id @default(cuid())
  key          String           @unique
  name         String
  capabilities RoleCapability[]
  members      SiteMember[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Capability {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  roles     RoleCapability[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model RoleCapability {
  roleId       String
  capabilityId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([roleId, capabilityId])
}

/// A group of sites that share users. Every site belongs to exactly one network.
model Network {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Themes sites may activate. Empty = every theme is allowed.
  enabledThemes  String[] @default([])
  /// Plugins active on every site of the network (sites cannot deactivate them).
  networkPlugins String[] @default([])
  /// Marketplace registry URLs (JSON catalogs of installable themes and plugins).
  registries     String[] @default([])
  sites     Site[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id            String         @id @default(cuid())
  networkId     String
  network       Network        @relation(fields: [networkId], references: [id])
  name          String
  slug          String         @unique
  /// Optional custom domain (lowercase hostname, no port). Unique across the install.
  domain        String?        @unique
  isDefault     Boolean        @default(false)
  posts         Post[]
  pages         Page[]
  revisions     Revision[]
  jobs          Job[]
  terms         Term[]
  media         Media[]
  comments      Comment[]
  postTypes     PostType[]
  taxonomies    Taxonomy[]
  menus         Menu[]
  menuLocations MenuLocation[]
  widgetAreas   WidgetArea[]
  settings      Setting[]
  themes        ThemeInstall[]
  templateParts TemplatePart[]
  themeMods ThemeMods[]
  templateOverrides TemplateOverride[]
  plugins       PluginInstall[]
  pluginData    PluginData[]
  members       SiteMember[]
  webhooks      Webhook[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isDefault])
}

enum PostStatus {
  draft
  publish
  scheduled
  private
  trash
}

model Post {
  id              String     @id @default(cuid())
  siteId          String
  site            Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId        String?
  author          User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  featuredMediaId String?
  featuredMedia   Media?     @relation("PostFeatured", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  type            String     @default("post")
  title           String
  slug            String
  status          PostStatus @default(draft)
  content         Json       @default("[]")
  publishedAt     DateTime?
  scheduledAt     DateTime?
  terms           PostTerm[]
  comments        Comment[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  searchVector Unsupported("tsvector")?

  @@unique([siteId, slug])
  @@index([siteId, status])
  @@index([siteId, type])
  @@index([siteId, createdAt])
  @@index([searchVector], type: Gin)
}

model Page {
  id          String     @id @default(cuid())
  siteId      String
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Page?      @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Page[]     @relation("PageTree")
  title       String
  slug        String
  status      PostStatus @default(draft)
  content     Json       @default("[]")
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  searchVector Unsupported("tsvector")?

  @@unique([siteId, slug])
  @@index([siteId, status])
  @@index([parentId])
  @@index([searchVector], type: Gin)
}

enum RevisionKind {
  revision
  autosave
}

/// Snapshot of a post/page body. entityType is "post" | "page".
model Revision {
  id         String       @id @default(cuid())
  siteId     String
  site       Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  authorId   String?
  kind       RevisionKind @default(revision)
  title      String
  content    Json         @default("[]")
  createdAt  DateTime     @default(now())

  @@index([siteId, entityType, entityId, createdAt])
}

enum JobStatus {
  pending
  running
  done
  failed
}

/// DB-backed job queue. Runner claims due pending rows.
model Job {
  id        String    @id @default(cuid())
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type      String
  payload   Json      @default("{}")
  runAt     DateTime
  status    JobStatus @default(pending)
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}

/// Taxonomy term. taxonomy is a registry key: "category", "tag", or a custom one.
model Term {
  id          String     @id @default(cuid())
  siteId      String
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  taxonomy    String
  name        String
  slug        String
  description String?
  parentId    String?
  parent      Term?      @relation("TermTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Term[]     @relation("TermTree")
  posts       PostTerm[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([siteId, taxonomy, slug])
  @@index([siteId, taxonomy])
}

model PostTerm {
  postId String
  termId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([postId, termId])
  @@index([termId])
}

/// DB-registered custom post type. Code-registered types live in lib/registry.ts.
model PostType {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  key        String
  label      String
  singular   String
  taxonomies String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([siteId, key])
}

/// DB-registered custom taxonomy. Terms reference it by key.
model Taxonomy {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  key          String
  label        String
  singular     String
  hierarchical Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([siteId, key])
}

model Media {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  filename   String
  /// Path relative to the storage root, e.g. 2026/10/<id>.png
  path       String   @unique
  mimeType   String
  size       Int
  altText    String   @default("")
  title      String   @default("")
  featuredIn Post[]   @relation("PostFeatured")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([siteId, createdAt])
}

enum CommentStatus {
  pending
  approved
  spam
  trash
}

model Comment {
  id          String        @id @default(cuid())
  siteId      String
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String
  authorEmail String
  content     String
  status      CommentStatus @default(pending)
  ip          String?
  userAgent   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([siteId, status, createdAt])
  @@index([postId, status])
}

model Menu {
  id        String         @id @default(cuid())
  siteId    String
  site      Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  items     MenuItem[]
  locations MenuLocation[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([siteId])
}

/// objectType: "custom" (uses url) | "post" | "page" (uses objectId).
model MenuItem {
  id         String     @id @default(cuid())
  menuId     String
  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   MenuItem[] @relation("MenuTree")
  label      String
  objectType String     @default("custom")
  objectId   String?
  url        String?
  position   Int        @default(0)

  @@index([menuId, position])
}

/// Assigns a menu to a theme location key (see lib/menus.ts for registered locations).
model MenuLocation {
  id       String @id @default(cuid())
  siteId   String
  site     Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  location String
  menuId   String
  menu     Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([siteId, location])
}

/// Theme-registered sidebar/footer region (see lib/widgets.ts for registered keys).
model WidgetArea {
  id      String   @id @default(cuid())
  siteId  String
  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  key     String
  name    String
  widgets Widget[]

  @@unique([siteId, key])
}

model Widget {
  id       String     @id @default(cuid())
  areaId   String
  area     WidgetArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  type     String
  settings Json       @default("{}")
  position Int        @default(0)

  @@index([areaId, position])
}

/// Per-site key/value options. Known keys and their validation live in lib/settings.ts.
model Setting {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  key    String
  value  Json

  @@unique([siteId, key])
}

/// A theme installed for a site. Code lives in /themes; exactly one install per site is active.
model ThemeInstall {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug        String
  version     String
  active      Boolean  @default(false)
  installedAt DateTime @default(now())

  @@unique([siteId, slug])
}

/// Site-edited content for a theme's template part (block JSON). Absent row = theme default.
model TemplatePart {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  theme     String
  slug      String
  content   Json     @default("[]")
  updatedAt DateTime @updatedAt

  @@unique([siteId, theme, slug])
}

/// Customizer state per site+theme: `published` is live, `draft` is what the admin is previewing.
model ThemeMods {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  theme     String
  published Json     @default("{}")
  draft     Json?
  updatedAt DateTime @updatedAt

  @@unique([siteId, theme])
}

/// Per-site rule: wherever the theme would use `template`, use `target` (another template of the same theme).
model TemplateOverride {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  theme     String
  template  String
  target    String
  createdAt DateTime @default(now())

  @@unique([siteId, theme, template])
}

/// A plugin installed for a site. Code lives in /plugins; `active` plugins are loaded on boot.
model PluginInstall {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug        String
  version     String
  active      Boolean  @default(false)
  /// Values for the settings declared in plugin.json (key -> string | boolean).
  settings    Json     @default("{}")
  installedAt DateTime @default(now())

  @@unique([siteId, slug])
}

/// Key/value storage handed to a plugin through `api.store`. Always scoped to one site and one plugin.
model PluginData {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  plugin    String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([siteId, plugin, key])
}

/// A user's role on one site. Users are shared across the network; what they can do is decided per site.
model SiteMember {
  siteId    String
  userId    String
  roleId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@id([siteId, userId])
  @@index([userId])
}

/// Bearer token for the REST API (CLI, scripts). Only a SHA-256 hash is stored; the token is shown once.
/// It carries its user's authority: what it can do on a site is decided by that user's role there.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// First characters of the token, to tell tokens apart in lists.
  prefix     String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Outbound HTTP call when content changes. Each delivery is signed with `secret` (HMAC-SHA256).
model Webhook {
  id        String    @id @default(cuid())
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String    @default("")
  url       String
  /// Subscribed events, e.g. post.published. See lib/webhooks/events.ts.
  events    String[]
  secret    String
  active    Boolean   @default(true)
  /// Outcome of the most recent delivery attempt.
  lastStatus Int?
  lastError  String?
  lastAt     DateTime?
  createdAt DateTime  @default(now())

  @@index([siteId, active])
}
