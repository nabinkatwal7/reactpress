generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  pages         Page[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id           String           @id @default(cuid())
  key          String           @unique
  name         String
  capabilities RoleCapability[]
  users        User[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Capability {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  roles     RoleCapability[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model RoleCapability {
  roleId       String
  capabilityId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([roleId, capabilityId])
}

model Site {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  isDefault Boolean  @default(false)
  posts     Post[]
  pages     Page[]
  revisions Revision[]
  jobs      Job[]
  terms     Term[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
}

enum PostStatus {
  draft
  publish
  scheduled
  private
  trash
}

model Post {
  id          String     @id @default(cuid())
  siteId      String
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title       String
  slug        String
  status      PostStatus @default(draft)
  content     Json       @default("[]")
  publishedAt DateTime?
  scheduledAt DateTime?
  terms       PostTerm[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, status])
  @@index([siteId, createdAt])
}

model Page {
  id          String     @id @default(cuid())
  siteId      String
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Page?      @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Page[]     @relation("PageTree")
  title       String
  slug        String
  status      PostStatus @default(draft)
  content     Json       @default("[]")
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([siteId, slug])
  @@index([siteId, status])
  @@index([parentId])
}

enum RevisionKind {
  revision
  autosave
}

/// Snapshot of a post/page body. entityType is "post" | "page".
model Revision {
  id         String       @id @default(cuid())
  siteId     String
  site       Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  authorId   String?
  kind       RevisionKind @default(revision)
  title      String
  content    Json         @default("[]")
  createdAt  DateTime     @default(now())

  @@index([siteId, entityType, entityId, createdAt])
}

enum JobStatus {
  pending
  running
  done
  failed
}

/// DB-backed job queue. Runner claims due pending rows.
model Job {
  id        String    @id @default(cuid())
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type      String
  payload   Json      @default("{}")
  runAt     DateTime
  status    JobStatus @default(pending)
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
}

/// Taxonomy term. taxonomy is a registry key: "category", "tag", or a custom one.
model Term {
  id          String     @id @default(cuid())
  siteId      String
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  taxonomy    String
  name        String
  slug        String
  description String?
  parentId    String?
  parent      Term?      @relation("TermTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Term[]     @relation("TermTree")
  posts       PostTerm[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([siteId, taxonomy, slug])
  @@index([siteId, taxonomy])
}

model PostTerm {
  postId String
  termId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([postId, termId])
  @@index([termId])
}
